# Configuración para integración con Supabase (Fase 2 / backend)
# Copiar a .env.local y completar con credenciales del proyecto Supabase.
# NO commitear credenciales reales.

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
# La SERVICE_ROLE_KEY NUNCA debe exponerse en el frontend. Usarla solo en funciones/servidor.
# SUPABASE_SERVICE_ROLE_KEY=...

# Configuración de plataforma
VITE_APP_PUBLIC_BASE_URL=https://tu-dominio.com
